VITE_API_BASE_URL=http://localhost:8080/api

# Supabase project — used only for Auth (sign in/up/out) and to read your
# own session. The anon key is safe to expose in frontend code; it has no
# power beyond what RLS policies on the project allow (see
# supabase/migrations/0001_init.sql and 0004_user_profiles_role_guard.sql).
# Leave both empty to run without auth — sign-in/admin-panel pages will
# show an explicit "not configured" state instead of failing silently.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
