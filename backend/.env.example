# Copy to .env and fill in real values. Never commit the real file.

PORT=8080
NODE_ENV=development

# Supabase project (server-side; service role key bypasses RLS — keep secret,
# backend-only, never sent to the frontend).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ML prediction service (see ../ml-service)
ML_SERVICE_URL=http://localhost:8000
# Shared secret with ml-service's own ML_SERVICE_API_KEY (its .env.example) —
# sent as the X-API-Key header on every request (predictionClient.ts, read
# directly from process.env rather than through the schema above, since it's
# a cross-cutting service-auth concern every one of this client's ~10 call
# sites would otherwise need to thread through unchanged). Leave both unset
# in dev/CI — ml-service enforces nothing without a configured key.
ML_SERVICE_API_KEY=

# Football data provider. Leave FOOTBALL_DATA_PROVIDER=null in dev — the
# provider abstraction falls back to a NullProvider that returns explicit
# "unavailable" responses instead of fabricating data.
#
# Two real providers are available — pick ONE, they are swappable
# alternatives, never both at once (see Data_Sources.md's "Two providers,
# never blended" section for why: they use unrelated external-id namespaces
# for the same real teams/competitions, so switching starts fresh entity
# rows rather than merging into existing ones):
#
#   api-football        Broad worldwide coverage (1,200+ leagues), but the
#                        free tier caps at 100 requests/DAY. Covers
#                        fixtures, standings, team/player stats, injuries,
#                        lineups, and odds. Get a key from
#                        https://www.api-football.com (or the same API via
#                        RapidAPI).
#   football-data-org    Only 12 major competitions (Premier League,
#                        Championship, La Liga, Bundesliga, Serie A, Ligue
#                        1, Eredivisie, Primeira Liga, Champions League,
#                        Brazilian Série A, World Cup, Euros) on its free
#                        tier, but no daily cap (10 requests/MINUTE
#                        instead) and curated (non-crowd-sourced) data.
#                        Fixtures and standings only — no team/player
#                        stats, injuries, lineups, or odds on the free
#                        tier (see FootballDataOrgProvider.ts). Get a key
#                        from https://www.football-data.org/client/register.
#
# The server fails fast at boot if FOOTBALL_DATA_PROVIDER names a real
# provider with no matching key set — see Data_Sources.md.
FOOTBALL_DATA_PROVIDER=null
#
# FOOTBALL_DATA_API_KEY does double duty: it's the api-football key when
# FOOTBALL_DATA_PROVIDER=api-football above, AND — independently of that
# setting — it's what enables a second, always-on api-football connection
# used only for odds/injuries/lineups (see Data_Sources.md's "The one
# exception" section). Set it even when FOOTBALL_DATA_PROVIDER=football-data-org
# if you want real odds/injuries/lineups alongside football-data.org's
# fixtures — leave it blank if you don't want that pipeline running at all.
FOOTBALL_DATA_API_KEY=

# Optional backup for FOOTBALL_DATA_API_KEY above: a RapidAPI key for the
# SAME vendor (API-Football via RapidAPI's api-football-v1 listing — see
# https://rapidapi.com/api-sports/api/api-football), used only as a
# failover when the primary (direct api-sports.io) channel fails after
# exhausting its own retries — never a load-balance between the two, and
# never used at all if the primary succeeds. Leave blank to run with no
# backup (identical to this project's original single-provider behavior).
# The two channels are separate subscriptions with separate quota pools,
# even though the underlying data and response shape are identical. Only
# meaningful when FOOTBALL_DATA_PROVIDER=api-football.
FOOTBALL_DATA_RAPIDAPI_KEY=

# Required only when FOOTBALL_DATA_PROVIDER=football-data-org.
FOOTBALL_DATA_ORG_API_KEY=

WEATHER_API_KEY=

# In-process cron scheduler for the sync/prediction jobs (see
# backend/src/scheduler/scheduler.ts). Off by default — turn on once you're
# ready for background syncing instead of manual POST /admin/*/sync calls.
# Assumes a single backend instance; running more than one replica with this
# on would sync everything N times over (no cross-process locking). Sync
# jobs are skipped (with one startup warning) if no data provider is
# configured; the predictions job still runs either way.
SCHEDULER_ENABLED=false

# CORS: comma-separated list of allowed origins.
ALLOWED_ORIGINS=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
