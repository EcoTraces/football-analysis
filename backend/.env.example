# Copy to .env and fill in real values. Never commit the real file.

PORT=8080
NODE_ENV=development

# Supabase project (server-side; service role key bypasses RLS — keep secret,
# backend-only, never sent to the frontend).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ML prediction service (see ../ml-service)
ML_SERVICE_URL=http://localhost:8000

# Football data provider credentials. Leave blank in dev — the provider
# abstraction falls back to a NullProvider that returns explicit
# "unavailable" responses instead of fabricating data. See Data_Sources.md.
FOOTBALL_DATA_PROVIDER=null
FOOTBALL_DATA_API_KEY=
ODDS_API_KEY=
WEATHER_API_KEY=

# CORS: comma-separated list of allowed origins.
ALLOWED_ORIGINS=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
