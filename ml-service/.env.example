# The ML service otherwise takes no external configuration — it is a pure
# function of the inputs the backend sends it (no database, no vendor API
# keys). This file exists so future config (e.g. a model registry path once
# training/backtesting land) has a documented place to go.

PORT=8000

# Shared secret with the backend's own ML_SERVICE_API_KEY (backend/.env.example)
# — every route except /health rejects requests without a matching X-API-Key
# header once this is set (see app/security.py). Leave unset in local
# dev/CI: this service otherwise has no auth of its own, but nothing outside
# this process can reach it there anyway.
ML_SERVICE_API_KEY=
